{$PUBLIC_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
  }

  # Keep the public app and authenticated API under one TLS origin. This avoids
  # browser CORS and cookie/session drift while leaving database and AI services
  # private to the Compose network.
  handle /api/* {
    reverse_proxy backend:3001
  }

  # Keep the backend liveness endpoint reachable for the VM and external
  # acceptance checks without exposing the database or intelligence services.
  handle /health {
    reverse_proxy backend:3001
  }

  handle {
    reverse_proxy frontend:80
  }
}
