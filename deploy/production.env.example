# Copy to deploy/production.env. Do not commit the copied file.
DATABASE_NAME=medripple
DATABASE_USER=medripple
DATABASE_PASSWORD=replace-with-a-long-unique-database-password
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
MYSQL_ROOT_PASSWORD=replace-with-a-long-unique-root-password
AUTH_JWT_SECRET=replace-with-a-unique-48-byte-base64url-secret
AUTH_TOKEN_TTL_MINUTES=480
PUBLIC_DOMAIN=app.your-public-domain.example
ACME_EMAIL=ops@your-public-domain.example
CORS_ORIGINS=https://app.your-public-domain.example
SIMULATION_DATE=2026-09-11
