# Backend runtime
BACKEND_PORT=3001
BACKEND_HOST=127.0.0.1
NODE_ENV=development

# Comma-separated browser origins. Leave empty to allow local development origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: URL of Druv's FastAPI service. Without it, the API returns clearly
# labelled deterministic fixture forecasts so the frontend can keep moving.
INTELLIGENCE_SERVICE_URL=
INTELLIGENCE_TIMEOUT_MS=2500

